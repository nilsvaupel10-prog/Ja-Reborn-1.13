    <string name="storage_permission_title">Dateizugriff erforderlich</string>
    <string name="storage_permission_message">JA2 benötigt Zugriff auf deinen gewählten Spieldatenordner. Android verlangt dafür, dass du für diese App "Zugriff zum Verwalten aller Dateien erlauben" aktivierst, bevor das Spiel starten kann.</string>
    <string name="storage_permission_legacy_message">JA2 benötigt Zugriff auf deinen gewählten Spieldatenordner. Bitte erlaube den Dateizugriff in der Android-Berechtigungsabfrage, bevor das Spiel startet.</string>
